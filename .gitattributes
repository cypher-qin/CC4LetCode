# 以 LF 存储，检出时按平台习惯还原；避免 Windows 克隆后立刻出现整库改动。
* text=auto

*.js   text eol=lf
*.mjs  text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.md   text eol=lf

# .gitattributes 自身必须是 LF。
.gitattributes text eol=lf

# Windows 一键脚本与批处理需要 CRLF。
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

*.png  binary
*.ico  binary
